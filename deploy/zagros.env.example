# Copy to /opt/zagros/zagros.env (outside the repository), then:  chown zagros:zagros zagros.env && chmod 600 zagros.env
# Loaded by deploy/zagros.service (EnvironmentFile). Names are ZAGROS__<SECTION>__<KEY> — see README → Configuration.

# --- required ---
ZAGROS__DATABASE__URL=postgres://zagros:CHANGE_ME@127.0.0.1:5432/zagros
# random string, 64+ characters:  openssl rand -hex 48        (the built-in default is PUBLIC — never use it in production)
ZAGROS__SERVER__COOKIE_SECRET=CHANGE_ME_LONG_RANDOM
ZAGROS__SERVER__BASE_URL=https://zagros.example.ir

# --- first administrator (promoted at every start, logs in with an OTP) ---
#ZAGROS__ADMIN__MOBILE=09xxxxxxxxx

# --- online payment (when you have a merchant account) ---
#ZAGROS__PAYMENT__ENABLED=true
#ZAGROS__PAYMENT__PROVIDER=zarinpal            # zarinpal | zibal
#ZAGROS__PAYMENT__MERCHANT=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- SMS one-time codes (otherwise the code is only printed in the log) ---
#ZAGROS__SMS__PROVIDER=kavenegar               # kavenegar | smsir | none
#ZAGROS__SMS__API_KEY=xxxxx
#ZAGROS__SMS__TEMPLATE=zagros-otp

# --- Telegram customer-club bot ---
#ZAGROS__TELEGRAM__ENABLED=true
#ZAGROS__TELEGRAM__TOKEN=123456789:replace-with-the-botfather-token

# --- e-mail (order confirmation, ticket replies); empty host = console mode ---
#ZAGROS__EMAIL__SMTP_HOST=smtp.example.ir
#ZAGROS__EMAIL__SMTP_PORT=587
#ZAGROS__EMAIL__SMTP_USER=
#ZAGROS__EMAIL__SMTP_PASS=
#ZAGROS__EMAIL__FROM="Zagros <no-reply@example.ir>"
